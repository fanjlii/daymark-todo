{
  "name": "daymark-todo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @daymark/api --filter @daymark/web dev",
    "dev:web": "pnpm --filter @daymark/web dev",
    "dev:api": "pnpm --filter @daymark/api dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "verify": "pnpm check && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=22"
  }
}
