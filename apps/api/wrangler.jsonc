{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daymark-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "api.middleware.top",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "ENVIRONMENT": "production",
    "CORS_ORIGINS": "https://todo.middleware.top"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daymark-db",
      "database_id": "f765d9f6-3c0d-4bad-b8da-b2de72845491",
      "migrations_dir": "migrations"
    }
  ]
}
